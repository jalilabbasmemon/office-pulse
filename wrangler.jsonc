{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "office-pulse",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Public runtime vars only.
  // Keep SUPABASE_SECRET_KEY as a Cloudflare Secret (never commit it here).
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://office-pulse.jalilabbasmemon.workers.dev",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_UyhHixVXD593dGb2uF46Tg_9dLHVicz",
    "NEXT_PUBLIC_SUPABASE_URL": "https://jniyfhpwrjofdljqsdwd.supabase.co"
  }
}

# Copy to .env.qa.local (gitignored) for local Next pointed at officepulse-qa.
# Never commit real secrets. Never use production project keys here.

NEXT_PUBLIC_SUPABASE_URL=https://hlcwsnhhmgjuxpebycyg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<qa-anon-or-publishable>
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=qa
E2E_TRUSTED_IP_ADAPTER=1

# Server-only — used by Next / QA Worker, NEVER passed to Playwright browser
SUPABASE_SECRET_KEY=<qa-service-role-or-sb_secret-from-officepulse-qa-dashboard>

# Disposable QA accounts (seeded on officepulse-qa)
E2E_ALLOW_PUNCH=1
E2E_EMPLOYEE_EMAIL=qa-employee@officepulse.test
E2E_EMPLOYEE_PASSWORD=<disposable>
E2E_ADMIN_EMAIL=qa-admin@officepulse.test
E2E_ADMIN_PASSWORD=<disposable>
E2E_VIEWER_EMAIL=qa-viewer@officepulse.test
E2E_VIEWER_PASSWORD=<disposable>
E2E_FORCE_PW_EMAIL=qa-forcepw@officepulse.test
E2E_FORCE_PW_PASSWORD=<disposable>
E2E_INACTIVE_EMAIL=qa-inactive@officepulse.test
E2E_INACTIVE_PASSWORD=<disposable>
E2E_OFFICE_IP=203.0.113.10
E2E_OFFICE_LAT=24.8607
E2E_OFFICE_LNG=67.0011

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Isolated QA Worker — NEVER the production name `office-pulse`.
  "name": "office-pulse-qa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Public vars only. SUPABASE_SECRET_KEY must be a Cloudflare Secret:
  //   npx wrangler secret put SUPABASE_SECRET_KEY --config wrangler.qa.jsonc
  // Use the officepulse-qa project secret only — never production.
  //
  // APP_ENV=qa (not production) so the E2E IP adapter may run on this Worker
  // when E2E_TRUSTED_IP_ADAPTER=1. Production wrangler.jsonc must keep
  // APP_ENV unset or "production" and must NOT set E2E_TRUSTED_IP_ADAPTER.
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://office-pulse-qa.jalilabbasmemon.workers.dev",
    "NEXT_PUBLIC_APP_ENV": "qa",
    "E2E_TRUSTED_IP_ADAPTER": "1",
    "NEXT_PUBLIC_SUPABASE_URL": "https://hlcwsnhhmgjuxpebycyg.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhsY3dzbmhobWdqdXhwZWJ5Y3lnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQ2NjkxOTksImV4cCI6MjExMDI0NTE5OX0.NopmHp3xKecFNbPyvhLQcfWA38S3K7JkRe5i56hSw3Q"
  }
}
